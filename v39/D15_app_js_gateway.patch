No início de function chamar(acao, dados, progresso), antes de montar qualquer request ao Apps Script, inserir:

  if (cfg.token === 'supabase-v39' && window.G2_V39 && G2_V39.mutationGateway && G2_V39.mutationGateway.isMutation(acao)) {
    return G2_V39.mutationGateway.execute(acao, dados || {}, progresso).catch(function (e) {
